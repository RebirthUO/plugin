{
  "optimizer_hints": {
    "capability": "UO Official Evidence",
    "inputs": [
      "Ultima Online gameplay claim or mechanic",
      "current production or historical target",
      "official and supporting evidence"
    ],
    "trigger_actions": [
      "Establish the official UO behavior for this mechanic.",
      "Research this Ultima Online production rule.",
      "Reconcile historical and current official behavior.",
      "Compare this engine implementation with OSI, EA, or Broadsword production."
    ],
    "exclusions": [
      "purely creative Ultima Online writing",
      "Publish-to-expansion mapping without a gameplay claim",
      "generic production software questions"
    ],
    "artifacts": [
      "classified evidence",
      "current versus historical reconciliation",
      "production implementation guidance",
      "confidence and unresolved gaps"
    ]
  },
  "fallback_positive_concepts": [
    "official_evidence",
    "multilingual_official_evidence"
  ],
  "positive_concepts": {
    "official_evidence": {
      "weight": 1.0,
      "phrases": [
        "official UO behavior",
        "OSI production mechanic",
        "EA Ultima Online formula",
        "Broadsword production parity"
      ]
    },
    "multilingual_official_evidence": {
      "weight": 0.9,
      "phrases": [
        "offiziellen UO Produktionsservern",
        "Spielmechanik auf OSI",
        "servidores oficiales de Ultima Online",
        "mecanica oficial de UO"
      ]
    }
  },
  "negative_concepts": {
    "near_neighbor": {
      "weight": 0.0,
      "exclusive": false,
      "phrases": [
        "Publish expansion gate",
        "fictional Ultima Online story"
      ]
    },
    "explicit_no_action": {
      "weight": 0.5,
      "exclusive": true,
      "phrases": [
        "do not research official behavior",
        "unrelated production system"
      ]
    }
  }
}
